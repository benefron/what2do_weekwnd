<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.benefron.weekwnd</string>

    <!-- caffeinate -ims: hold an idle+system+disk sleep assertion for the life
         of the pipeline. Without it a LaunchAgent is just another background
         process — it does not itself keep the Mac awake, so a run that starts
         on a wake-triggered catch-up can be suspended by the very next idle
         sleep and never resume. That is what silently dropped the 2026-09-14
         run: it got 6/14 enrichment batches in, the Mac slept, and it was
         killed before reaching publish/commit/push. (This does not cover a
         closed lid with no external display — only caffeinate -u or staying
         open prevents that.) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-ims</string>
        <string>__REPO_ROOT__/automation/.venv/bin/python3</string>
        <string>__REPO_ROOT__/automation/run_weekly.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/automation</string>

    <!-- Monday 07:30.
         RunAtLoad is deliberately absent: launchd evaluates a
         StartCalendarInterval slot missed while the Mac was asleep/off on its
         next wake, so a Mac that was off Monday still runs the pipeline when it
         wakes. run_weekly.py's MIN_HOURS_BETWEEN_RUNS guard + the file lock
         absorb any catch-up fire so it never double-runs. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/automation/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/automation/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__CLAUDE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
